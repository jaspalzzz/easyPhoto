# easyPhoto — build-time environment variables
# Copy to .env.production (or set in your host's dashboard) and rebuild.

# Canonical site origin. Drives canonical URLs, OpenGraph, sitemap, robots.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://easyphoto.in

# Search-engine ownership verification (optional — renders <meta> only when set).
# Google Search Console → Settings → Ownership verification → "HTML tag":
#   copy ONLY the content="..." value here.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools → "Meta tag" option → the msvalidate.01 content value.
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# AdSense ad-serving runtime. BAKED IN AT BUILD TIME (NEXT_PUBLIC_* vars are
# inlined by Next.js — changing this in a host dashboard requires a rebuild).
# Keep unset (or "false") until AdSense approval and planned ad slots are ready.
# Excluded paths are hardcoded in components/site/AdSenseScript.tsx.
NEXT_PUBLIC_ADSENSE_ENABLED=false

# "Support easyPhoto" tip pop-up (components/site/SupportCard.tsx), shown once
# per session right after a file is saved. BAKED IN AT BUILD TIME.
# Leave all of these unset (or blank) and it never renders — that is also the
# rollback. Each option is independent; every device gets the one with the
# fewest steps that works there. Invalid values are ignored with a console
# warning.
#
# Android: the upi://pay link encoded in the merchant's Razorpay QR (QR Codes →
# Multiple Payments, any amount). Each ₹10/₹20/₹50 button opens the UPI app
# with this link plus the amount — no form. Paste the decoded QR text as-is.
NEXT_PUBLIC_UPI_LINK=
# Computers: site path to that QR image in public/ (e.g. /upi-qr.png), shown
# to scan with a phone.
NEXT_PUBLIC_UPI_QR_SRC=
#
# iPhone always, and Android/computers when the options above aren't set:
# three Razorpay Payment Pages, one per amount (https on rzp.io,
# pages.razorpay.com or razorpay.me), opening in a new tab. Razorpay asks for
# email and phone there. All three must be valid or none is used.
NEXT_PUBLIC_SUPPORT_PAGE_10=
NEXT_PUBLIC_SUPPORT_PAGE_20=
NEXT_PUBLIC_SUPPORT_PAGE_50=
