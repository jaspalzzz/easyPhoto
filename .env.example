# easyPhoto — build-time environment variables
# Copy to .env.production (or set in your host's dashboard) and rebuild.

# Canonical site origin. Drives canonical URLs, OpenGraph, sitemap, robots.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://easyphoto.in

# Search-engine ownership verification (optional — renders <meta> only when set).
# Google Search Console → Settings → Ownership verification → "HTML tag":
#   copy ONLY the content="..." value here.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools → "Meta tag" option → the msvalidate.01 content value.
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# AdSense ad-serving runtime. BAKED IN AT BUILD TIME (NEXT_PUBLIC_* vars are
# inlined by Next.js — changing this in a host dashboard requires a rebuild).
# Keep unset (or "false") until AdSense approval and planned ad slots are ready.
# Excluded paths are hardcoded in components/site/AdSenseScript.tsx.
NEXT_PUBLIC_ADSENSE_ENABLED=false

# "Support easyPhoto" tip card (components/site/SupportCard.tsx), shown once
# per session below a tool after a file is saved. BAKED IN AT BUILD TIME.
# Leave all of these unset (or blank) and the card never renders — that is also
# the rollback.
#
# Preferred: three reusable Razorpay Payment Pages, one per amount. With all
# three set (https on rzp.io, pages.razorpay.com or razorpay.me), every device
# — Android, iPhone and computers — gets the ₹10/₹20/₹50 buttons, opening the
# page in a new tab. Anything else is ignored with a console warning.
NEXT_PUBLIC_SUPPORT_PAGE_10=
NEXT_PUBLIC_SUPPORT_PAGE_20=
NEXT_PUBLIC_SUPPORT_PAGE_50=
#
# Alternative: a business/merchant UPI ID (name@handle) for upi://pay links on
# Android and a QR on computers. Used only when the pages above aren't set; an
# invalid value is ignored with a console warning.
NEXT_PUBLIC_UPI_VPA=
# Payee name shown in the UPI app. Defaults to "easyPhoto".
NEXT_PUBLIC_UPI_PAYEE_NAME=
# Optional site path to the merchant QR image in public/ (e.g. /upi-qr.png).
# Desktop and iPhone see the card only when this is set; Android uses the
# upi://pay deep link instead.
NEXT_PUBLIC_UPI_QR_SRC=
